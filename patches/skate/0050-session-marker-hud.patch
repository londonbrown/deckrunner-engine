+/// Skate's session marker as a HUD shows it (overlay patch 0050), after the
+/// last `advance`: Skate 3's marker prompts show while LB is held.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct MarkerHud {
+    /// LB is held: the marker's prompts are up.
+    pub visible: bool,
+    /// A marker can be placed here now.
+    pub can_place: bool,
+    /// A marker is placed and can be returned to now.
+    pub can_return: bool,
+    /// How far LB + d-pad up's hold has run toward the return (0..1; it
+    /// fires at 1: 0.2 s within 100 m of the marker, up to 1 s at 1 km).
+    pub progress: f32,
+    /// Counts since the session began: markers placed, placements refused,
+    /// returns made, and return holds let go before they fired.
+    pub placed: u32,
+    pub refused: u32,
+    pub returned: u32,
+    pub short_holds: u32,
+}
+
 impl Session {
+    /// SkateV (patch 0050): the session marker's HUD publication.
+    pub fn marker_hud(&self) -> MarkerHud {
+        let m = self.markers.state();
+        MarkerHud {
+            visible: m.visible,
+            can_place: m.can_place,
+            can_return: m.can_return,
+            progress: m.progress,
+            placed: m.placed,
+            refused: m.refused,
+            returned: m.returned,
+            short_holds: m.short_holds,
+        }
+    }
+
